# Everything is optional — the app runs with no configuration (demo mode + in-memory store).

# Add an Anthropic key to switch from the offline planner to Claude.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_SUBAGENT_MODEL=claude-sonnet-5-5

# Supabase (server-side only) to persist trips.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: LangSmith tracing for the agent graph.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
