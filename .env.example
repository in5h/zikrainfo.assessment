# Required: the agent runs on Claude via LangChain's ChatAnthropic.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown).
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_SUBAGENT_MODEL=claude-sonnet-5-5

# Supabase (server-side only). If unset, the app uses an in-memory demo store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: LangSmith tracing for the agent graph.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
